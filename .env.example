# Public client keys. Copy to `.env` locally and to the Vercel project settings.
# The anon key is safe in the browser. The service role key is not.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never prefix this with VITE_ and never import it from client code.
# Used to debit balance, refund a failed order, and insert proxies.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago. The access token is server-only. Never prefix it with VITE_.
# The public key is safe in the browser and is used to tokenize cards.
MP_ACCESS_TOKEN=
VITE_MP_PUBLIC_KEY=
# Public HTTPS origin for the Mercado Pago webhook. Localhost is ignored.
# When this is empty or local, charges use https://brazilproxy.vercel.app/api/webhook/mercadopago
APP_URL=

# Proxy-Cheap. Keep the real values in .env.local or the Vercel project settings.
# MOCK_MODE=true provisions a fake proxy and does not call the paid API.
PROXY_CHEAP_API_KEY=
PROXY_CHEAP_API_SECRET=
PROXY_CHEAP_MOCK_MODE=true

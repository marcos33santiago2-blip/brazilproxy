# Public client keys. Copy to `.env` locally and to the Vercel project settings.
# Do not put the service role key here — it must never ship to the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Proxy-Cheap. Keep the real values in .env.local or the Vercel project settings.
# MOCK_MODE=true provisions a fake proxy and does not call the paid API.
PROXY_CHEAP_API_KEY=
PROXY_CHEAP_API_SECRET=
PROXY_CHEAP_MOCK_MODE=true
